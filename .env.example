# Hutchrok OS — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit actual secrets to the repository.

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
APP_ENV=local

# ============================================================
# DATABASE (PostgreSQL / Supabase)
# ============================================================
DATABASE_URL=******localhost:5432/hutchrok_os

# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ============================================================
# API
# ============================================================
API_PORT=3001
API_BASE_URL=http://localhost:3001
API_SECRET_KEY=<generate-with-openssl-rand-hex-32>
WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# ============================================================
# COMMAND CENTER
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ============================================================
# AI PROVIDERS
# ============================================================
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
GOOGLE_AI_API_KEY=<your-google-ai-api-key>
HIGGSFIELD_API_KEY=<your-higgsfield-api-key>

# ============================================================
# GOOGLE WORKSPACE (hutchrok.com domain)
# ============================================================
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account@hutchrok-os.iam.gserviceaccount.com>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<base64-encoded-private-key>
GOOGLE_WORKSPACE_DOMAIN=hutchrok.com

# ============================================================
# COMMUNICATIONS (provider-neutral — configure adapter)
# ============================================================
# Set COMMS_PROVIDER to: twilio | telnyx | mock
COMMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>
TELNYX_API_KEY=<your-telnyx-api-key>
TELNYX_PHONE_NUMBER=<your-telnyx-phone-number>

# ============================================================
# PAYMENTS (Stripe)
# ============================================================
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ============================================================
# GITHUB INTEGRATION
# ============================================================
GITHUB_APP_ID=<your-github-app-id>
GITHUB_APP_PRIVATE_KEY=<base64-encoded-private-key>
GITHUB_WEBHOOK_SECRET=<your-github-webhook-secret>
GITHUB_ORG=FeeTheDeveloper

# ============================================================
# WEBSITE INGESTION
# ============================================================
# Shared secret for signing/validating website event payloads
WEBSITE_INGESTION_SECRET=<generate-with-openssl-rand-hex-32>

# ============================================================
# QUEUE / JOBS
# ============================================================
# Options: pg-boss | bullmq | mock
QUEUE_PROVIDER=pg-boss

# ============================================================
# STORAGE
# ============================================================
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=hutchrok-documents

# ============================================================
# ENCRYPTION
# ============================================================
# 32-byte key for encrypting sensitive fields at rest
FIELD_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# ============================================================
# MCP SERVER
# ============================================================
MCP_SERVER_PORT=3002
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
