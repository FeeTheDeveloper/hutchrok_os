FROM node:22-alpine AS base
RUN npm install -g pnpm@9
WORKDIR /app

# Install dependencies
COPY pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/kernel/package.json ./packages/kernel/
COPY packages/domain/package.json ./packages/domain/
COPY packages/events/package.json ./packages/events/
COPY packages/audit/package.json ./packages/audit/
COPY packages/policies/package.json ./packages/policies/
COPY packages/approvals/package.json ./packages/approvals/
COPY packages/ai/package.json ./packages/ai/
COPY packages/agents/package.json ./packages/agents/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/connectors/package.json ./packages/connectors/

RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY config/ ./config/
COPY apps/api/ ./apps/api/
COPY packages/ ./packages/

# Build
RUN pnpm --filter @hutchrok-os/shared build && \
    pnpm --filter @hutchrok-os/kernel build && \
    pnpm --filter @hutchrok-os/domain build && \
    pnpm --filter @hutchrok-os/events build && \
    pnpm --filter @hutchrok-os/audit build && \
    pnpm --filter @hutchrok-os/policies build && \
    pnpm --filter @hutchrok-os/approvals build && \
    pnpm --filter @hutchrok-os/ai build && \
    pnpm --filter @hutchrok-os/agents build && \
    pnpm --filter @hutchrok-os/mcp build && \
    pnpm --filter @hutchrok-os/connectors build && \
    pnpm --filter @hutchrok-os/api build

EXPOSE 3001
CMD ["node", "apps/api/dist/index.js"]
