{
  "name": "@hutchrok-os/api",
  "version": "1.0.0",
  "private": true,
  "description": "Hutchrok OS — Core API server (Hono / Node.js)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hutchrok-os/shared": "workspace:*",
    "@hutchrok-os/kernel": "workspace:*",
    "@hutchrok-os/domain": "workspace:*",
    "@hutchrok-os/events": "workspace:*",
    "@hutchrok-os/audit": "workspace:*",
    "@hutchrok-os/policies": "workspace:*",
    "@hutchrok-os/approvals": "workspace:*",
    "@hutchrok-os/ai": "workspace:*",
    "@hutchrok-os/agents": "workspace:*",
    "@hutchrok-os/mcp": "workspace:*",
    "@hutchrok-os/connectors": "workspace:*",
    "hono": "^4.5.0",
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.24.0"
  }
}
